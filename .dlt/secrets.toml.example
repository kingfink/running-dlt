# Copy to .dlt/secrets.toml and fill in. Never commit the real file.
#
# Project / dataset / location come from env vars, not this file. Set them in
# your shell (or a .envrc) before running locally:
#
#   export BIGQUERY_PROJECT=<gcp-project-id>
#   export BIGQUERY_DATASET=strava_dev_$USER
#   export BIGQUERY_LOCATION=US                 # optional
#   export MOTHERDUCK_DATABASE=<database-name>
#   export MOTHERDUCK_DATASET=strava_dev_$USER

[sources.strava]
client_id = "<from https://www.strava.com/settings/api>"
client_secret = "<from https://www.strava.com/settings/api>"
refresh_token = "<run scripts/authorize.py once to mint this>"

[destination.bigquery.credentials]
private_key = """-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"""
client_email = "<service-account>@<project>.iam.gserviceaccount.com"

[destination.motherduck.credentials]
# Your MotherDuck access token (https://app.motherduck.com -> Settings -> Tokens).
password = "<motherduck-token>"
